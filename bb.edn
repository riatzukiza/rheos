{:tasks
 {build {:doc "Build production server + CLI"
         :task (shell "shadow-cljs release server cli")}
  watch {:doc "Dev watch with hot-reload"
         :task (shell "shadow-cljs watch server-dev")}
  test {:doc "Build the CLI and run tests"
        :task (do (shell "shadow-cljs release cli")
                  (shell "shadow-cljs compile test")
                  (shell "node dist/test.cjs"))}
  lint {:doc "Lint source with clj-kondo"
        :task (shell "clj-kondo --lint src test")}
  clean {:doc "Clean build artifacts"
         :task (shell "rm -rf dist dist-dev target")}}}
